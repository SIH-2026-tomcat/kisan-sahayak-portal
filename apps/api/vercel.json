{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npm install && npm run build -w packages/db",
  "installCommand": "npm install --prefix ../..",
  "framework": null,
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
