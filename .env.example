# Database (Neon Postgres, pooled)
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Auth (Managed Better Auth)
NEON_AUTH_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate-a-32-plus-char-random-secret"
NEON_AUTH_WEBHOOK_SECRET=""

# Shared secret between the web BFF and the API (short-lived internal tokens)
INTERNAL_JWT_SECRET="generate-a-32-plus-char-random-secret"

# App URLs. PUBLIC_APP_URL is a comma-separated CORS allow-list for the API.
PUBLIC_API_URL="http://localhost:3001"
PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (private, authenticated Aadhaar uploads under a dedicated folder)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_AADHAAR_FOLDER="kisan-sahayak/aadhaar"

# Email (Resend). EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY="re_..."
EMAIL_FROM="kisansahayak@hawkvance.in"
EMAIL_REPLY_TO="kisansahayak@hawkvance.in"

# Admin bootstrap: the first user to sign up with this email becomes super_admin
ADMIN_EMAIL="admin@hawkvance.in"

# Deployment tokens (CLI only, not app runtime)
VERCEL_TOKEN=""
RENDER_TOKEN=""
